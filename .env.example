# Server
PORT=8080
COOKIE_SECURE=false          # set true jika dipasang di belakang HTTPS
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Supabase PostgreSQL  (Project Settings > Database > Connection string > URI)
# Pakai "Session pooler" / "Direct connection". Transaction pooler (6543) juga didukung.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Admin pertama (hanya dibuat jika tabel admins masih kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
ADMIN_NAME=Administrator

# Foto anggota (opsional). Kosongkan untuk menyimpan di folder lokal ./uploads
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=member-photos
UPLOAD_DIR=uploads

# --- Khusus deploy di Vercel (serverless) ---
# DB_MAX_CONNS=3                 # koneksi per instance; cegah kehabisan koneksi database
# TRUSTED_IP_HEADER=X-Real-Ip    # agar pembatas login memakai IP pengunjung, bukan IP proxy Vercel
# COOKIE_SECURE=true
# Foto WAJIB lewat Supabase Storage (isi SUPABASE_URL dan SUPABASE_SERVICE_KEY): disk Vercel tidak permanen.
